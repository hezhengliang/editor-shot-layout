{
  "name": "wafermap-app",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "packageManager": "pnpm@11.20.0",
  "scripts": {
    "dev": "turbo run dev",
    "dev:client": "turbo run dev --filter=@wafermap/web",
    "server": "pnpm --filter @wafermap/server dev",
    "build": "turbo run build",
    "preview": "pnpm --filter @wafermap/web preview",
    "app": "pnpm --filter @wafermap/client",
    "app:dev": "pnpm --filter @wafermap/client tauri:dev",
    "app:install": "pnpm --filter @wafermap/client app:install"
  },
  "devDependencies": {
    "playwright-core": "^1.64.1",
    "turbo": "^2.5.0"
  }
}
