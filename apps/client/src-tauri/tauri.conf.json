{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Shot Layout",
  "version": "0.1.0",
  "identifier": "com.shotlayout.app",
  "build": {
    "frontendDist": "../../web/dist",
    "devUrl": "http://localhost:5173",
    "beforeDevCommand": "pnpm --filter @wafermap/web exec vite",
    "beforeBuildCommand": "pnpm --filter @wafermap/web build"
  },
  "app": {
    "windows": [
      {
        "title": "Shot Layout",
        "width": 1500,
        "height": 950,
        "minWidth": 1100,
        "minHeight": 700
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: http://localhost:8000; connect-src 'self' http://localhost:8000"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
